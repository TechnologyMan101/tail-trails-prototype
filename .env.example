SECRET_KEY=replace-with-a-long-random-value
TRUSTED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
COOKIE_SECURE=false
TAILTRAILS_PORT=8000
POSTGRES_DB=tailtrails
POSTGRES_USER=tailtrails
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PHOTO_WEB_WIDTH=1600
PHOTO_WEB_HEIGHT=1200
PHOTO_WEB_QUALITY=82
MAX_PHOTO_SIZE_MB=25
MAX_REQUEST_SIZE_MB=160
BRANDING_LOGO_SIZE=512
BRANDING_BANNER_WIDTH=1920
BRANDING_BANNER_HEIGHT=640
BRANDING_WEB_QUALITY=85
BRANDING_MAX_SIZE_MB=25
PHOTO_BATCH_TTL_MINUTES=30
PHOTO_BATCH_CLEANUP_INTERVAL_MINUTES=60

# Match these to the owner of the local data/ and uploads/ folders on Linux.
TAILTRAILS_UID=1000
TAILTRAILS_GID=1000
